# Copy this file to ".env" and paste your free key from https://console.groq.com/keys
# Never commit .env or share your key.
GROQ_API_KEY=paste_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional: smaller model used automatically if the main one is rate-limited
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
